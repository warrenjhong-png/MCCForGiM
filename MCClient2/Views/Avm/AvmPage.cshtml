

<link rel="stylesheet" href="~/Content/kendo/2019.3.1023/kendo.default.min.css">
<link rel="stylesheet" href="~/Content/kendo/2019.3.1023/kendo.common.min.css">

@section scripts {
    <script>
        $(document).ready(function () {
            AvmPage.Main();
        });
    </script>
}

<div id="divVue">
    <div class="row">
        <div class="guide col-md-2">
            <ul>
                <li class="setp-working">
                    <div>1. Data Collection</div>
                    <div>Combination Selection </div>
                </li>
                <li>
                    <div>2. Data Collection</div>
                    <div>Variable Selection</div>
                </li>
                <li>
                    <div>3. Raw Data</div>
                    <div>Preprocessing</div>
                </li>
                <li>
                    <div>4. Parameter</div>
                    <div>Setting</div>
                </li>
            </ul>
            <div>Task ID:</div>
            <div>{{taskId}}</div>
            <div class="modelProcessInfo">
                <span style="display:none">Model : {{info}}</span>
                <div style="display:none">
                    <button v-on:click="loopBuildModel('loop')">Loop</button>
                    <button v-on:click="loopBuildModel('break')">Next break</button>
                    <div>Loop Count : {{loopCount}}</div>
                </div>
            </div>



        </div>
        <div class="selection col-lg-10">
            <div class="selection-work">
                <div class="combination-selection" v-show="avmItemPage==0">
                    <div class="date-grid row">
                        <div class="col-lg-6">
                            <div class="setting-title">Time Period</div>
                            <div class="setting-body" style="min-height:75px;padding-top:15px;">
                                <label for="data-start">Start Time:<input class="date-start"></label>
                                <label for="data-end">End Time:<input class="date-end"></label>
                                <button class="btn btn-primary click-query-btn" v-on:click="clickQuery">Query</button>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="setting-title">Piece Count</div>
                            <div class="setting-body text-center">
                                @*因資料量多不提供選擇*@
                                @*<div class="setting-body text-center" v-on:click="pieceSelect" style="cursor:pointer">*@
                                <h2>{{pieceCount}}</h2>
                            </div>
                        </div>
                        <button class="btn btn-primary get-piece-btn"
                                v-on:click="getPieceCount">
                            Get Piece
                        </button>
                    </div>
                    <div class="fab-grid row">

                    </div>
                    <div class="piece-select-window" v-show="pieceWindow">
                        <div class="piece-grid">
                        </div>
                        <div class="piece-setting">
                            <button class="piece-close-btn btn btn-danger">Close</button>
                            <button class="piece-setting-btn btn btn-primary" v-on:click="pieceSetting">Set</button>
                        </div>
                    </div>
                </div>
                <div class="variable-selection" v-show="avmItemPage==1">
                    <div class="count-grid row">
                        <div class="col-lg-9">
                            <div class="setting-title">Input Count</div>
                            <div class="setting-body text-center">
                                <h2>{{inputCount}}</h2>
                            </div>
                            <div class="variables-process-grid row">
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="setting-title">Output Count</div>
                            <div class="setting-body text-center">
                                <h2>{{outputCount}}</h2>
                            </div>
                            <div class="variables-metrology-grid row">
                            </div>
                        </div>
                    </div>
                    @*<div class="variables-grid row">

                        </div>*@
                </div>
                <div class="rawdata-prerocessing" v-show="avmItemPage==2">
                    <div class="rawdata-variable-grid row">
                        <div class="col-lg-3">
                            <div class="setting-title">Variable Groups</div>
                            <div class="variableGroups-grid" style="height:30vh;"></div>
                        </div>
                        <div class="col-lg-3">
                            <div class="setting-title">Variables</div>
                            <div class="variablesName-grid" style="height:30vh;"></div>
                        </div>
                        <div class="col-lg-2" style="display:none;">
                            <div class="setting-title">Chart Option</div>
                            <div class="stepId-grid" style="height:30vh;"></div>
                        </div>
                        <div class="col-lg-2" style="display:none;">
                            <div class="setting-title">Algorithms</div>
                            <div class="algorithms-grid" style="height:30vh;"></div>
                        </div>
                        <div class="col-lg-2" style="display:none;">
                            <div class="spec-grid">
                                <ul>
                                    <li><label for="usl">USL : <input class="usl" v-model="usl" disabled></label></li>
                                    <li><label for="lsl">LSL : <input class="lsl" v-model="lsl" disabled></label></li>
                                    <li>
                                        <div class="spec-arrow" v-on:click="specSetting">► setting</div>
                                        <div class="spec-setting">
                                            <ul>
                                                <li><input type="checkbox" class="specManual" v-model="specManual" v-on:click="specCheck('specManual')"><label for="specManual">By Manual</label></li>
                                                <li>
                                                    <input type="checkbox" class="specSigma" v-model="specSigma" v-on:click="specCheck('specSigma')">
                                                    <label for="specSigma">By <input style="width:40px" v-model="specSigmaValue"> x sigma</label>
                                                </li>
                                                <li>
                                                    <input type="checkbox" class="specPercentage" v-model="specPercentage" v-on:click="specCheck('specPercentage')">
                                                    <label for="specPercentage">By <input style="width:40px" v-model="specPercentageValue"> x Percentage</label>
                                                </li>
                                            </ul>
                                        </div>
                                    </li>

                                    <li><label for="ucl">UCL : <input class="ucl" v-model="ucl" disabled></label></li>
                                    <li><label for="lcl">LCL : <input class="lcl" v-model="lcl" disabled></label></li>
                                    <li>
                                        <div class="spec-arrow" v-on:click="conSetting">► setting</div>
                                        <div class="con-setting">
                                            <ul>
                                                <li><input type="checkbox" class="conManual" v-model="conManual" v-on:click="conCheck('conManual')"><label for="conManual">By Manual</label></li>
                                                <li>
                                                    <input type="checkbox" class="conSigma" v-model="conSigma" v-on:click="conCheck('conSigma')">
                                                    <label for="conSigma">By <input style="width:40px" v-model="conSigmaValue"> x sigma</label>
                                                </li>
                                                <li>
                                                    <input type="checkbox" class="conPercentage" v-model="conPercentage" v-on:click="conCheck('conPercentage')">
                                                    <label for="conPercentage">By <input style="width:40px" v-model="conPercentageValue"> x Percentage</label>
                                                </li>

                                            </ul>
                                        </div>
                                    </li>
                                    <li class="row">
                                        <button class="btn btn-primary col-lg-5" style="margin:5px;display:none;" v-on:click="temporalDataChart">Raw Data</button>
                                        @*<button class="btn btn-primary col-lg-5" style="margin:5px;display:none;" v-on:click="specComputed">Spec</button>*@
                                        @*<button class="btn btn-primary col-lg-5" style="margin:5px;" v-on:click="addRule">Add Rule</button>*@
                                        <img class="warning-icon" v-show="warningImg" src="~/Img/warning-icon.svg">
                                        <button class="btn btn-warning col-lg-5" style="margin:5px;" v-on:click="warningId">Warning ID </button>
                                    </li>
                                </ul>
                            </div>
                            <div class="warning-id-window" v-show="warningWindow">
                                <div class="warning-grid">
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 position-relative" style="height:34vh;">
                            <button class="btn btn-primary add-rule-btn"
                                    v-on:click="addRuleForEnergyPrediction">
                                Add Rule
                            </button>
                        </div>
                    </div>
                    <div class="temporaldata-grid row" style="display:none;">
                        <div class="col-lg-12">
                            <div class="setting-title">Temporal Data Chart</div>
                            <div class="temporaldata-chart" style="height:32.5vh" v-show="temporalData"></div>
                            <div class="load-preset" style="height:32.5vh" v-show="preset"><p>File Loading...</p></div>
                            <div class="temporaldata-toolbar">
                                <span><label for="limit">Limit <input class="limit" type="checkbox" v-model="limitCheckBox"></label></span>
                                <span><label for="trimBegin">Trim Begin : {{trimBeginSet}} <input class="trimBegin" v-model="inputBegin"></label></span>
                                <span><label for="trimEnd">Trim End : {{trimEndSet}} <input class="trimEnd" v-model="trimEnd"></label></span>
                                <button class="btn btn-primary" v-on:click="trim">Trim</button>
                            </div>
                        </div>
                    </div>
                    <div class="indicator-rule-grid row">
                        <div class="col-lg-12">
                            <div class="setting-title">Indicator Rule</div>
                            <div class="rule-grid" style="height:33.5vh;"></div>
                        </div>
                    </div>
                    <div class="indicator-rule-chart row" style="display:none;">
                        <div class="col-lg-12">
                            <div class="setting-title">Indicator Rule Chart</div>
                            <div class="rule-chart" style="height:32.5vh"></div>
                        </div>
                    </div>
                </div>
                <div class="parameter-layout" v-show="avmItemPage==3">

                    <!-- LEFT：Energy -->
                    <div class="param-card energy-card">

                        <div class="setting-title">Energy Prediction Model</div>

                        <div class="param-card-body">

                            <!-- Training -->
                            <div class="param-section">
                                <div class="section-title">Training</div>
                                <div class="param-row"><label>num_epoches</label><input v-model="num_epoches"><span>Epochs</span></div>
                                <div class="param-row"><label>patience</label><input v-model="patience"><span>Epochs</span></div>
                                <div class="param-row"><label>scheduler_patience</label><input v-model="scheduler_patience"><span>Epochs</span></div>
                                <div class="param-row"><label>model_set_proportion</label><input v-model="model_set_proportion"></div>
                                <div class="param-row"><label>threshold_scaler</label><input v-model="threshold_scaler"></div>
                                <div class="param-row"><label>split</label><input v-model="split"><span>%</span></div>
                                <div class="param-row"><label>seq_len</label><input v-model="seq_len"><span>Time Steps</span></div>
                                <div class="param-row"><label>forecasting_len</label><input v-model="forecasting_len"><span>Time Steps</span></div>
                            </div>

                            <!-- Fine Tune -->
                            <div class="param-section">
                                <div class="section-title">Fine Tune</div>

                                <div class="param-row"><label>finetune_time_max</label><input v-model="finetune_time_max"><span>分鐘</span></div>
                                <div class="param-row"><label>fine_tune_split</label><input v-model="fine_tune_split"><span>%</span></div>
                                <div class="param-row"><label>fine_tune_len</label><input v-model="fine_tune_len"><span>Samples</span></div>
                                <div class="param-row"><label>fine_tune_lr_m1</label><input v-model="fine_tune_lr_m1"><span>LR</span></div>
                                <div class="param-row"><label>fine_tune_lr_m2</label><input v-model="fine_tune_lr_m2"><span>LR</span></div>
                                <div class="param-row"><label>fine_tune_lr_gsi</label><input v-model="fine_tune_lr_gsi"><span>LR</span></div>
                            </div>

                            <!-- In-flow forecast common configuration -->
                            <div class="param-section">
                                <div class="section-title">Forecast Common Configuration</div>
                                <div class="param-row"><label>fine_tune_len_seconds</label><input type="number" v-model.number="fine_tune_len_seconds"><span>Seconds</span></div>
                                <div class="param-row"><label>fine_tune_len_steps</label><input type="number" v-model.number="fine_tune_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>finetune_cooldown_points</label><input type="number" v-model.number="finetune_cooldown_points"><span>Points</span></div>
                                <div class="param-row"><label>finetune_retrain_times</label><input type="number" v-model.number="finetune_retrain_times"><span>Times</span></div>
                                <div class="param-row"><label>flow_zero_threshold</label><input type="number" step="0.1" v-model.number="flow_zero_threshold"></div>
                                <div class="param-row"><label>fine_tune_batch_size_m1</label><input type="number" v-model.number="fine_tune_batch_size_m1"></div>
                                <div class="param-row"><label>fine_tune_batch_size_m2</label><input type="number" v-model.number="fine_tune_batch_size_m2"></div>
                                <div class="param-row"><label>downsample_seconds</label><input type="number" v-model.number="downsample_seconds"><span>Seconds</span></div>
                                <div class="param-row"><label>seq_len_steps</label><input type="number" v-model.number="seq_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>forecasting_len_steps</label><input type="number" v-model.number="forecasting_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>patch_len</label><input type="number" v-model.number="patch_len"></div>
                                <div class="param-row"><label>patch_len_steps</label><input type="number" v-model.number="patch_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>stride_seconds</label><input type="number" v-model.number="stride_seconds"><span>Seconds</span></div>
                                <div class="param-row"><label>stride_steps</label><input type="number" v-model.number="stride_steps"><span>Steps</span></div>
                                <div class="param-row"><label>max_samples</label><input type="number" v-model.number="max_samples"><span>Samples</span></div>
                                <div class="param-row">
                                    <label>predict_residual</label>
                                    <select v-model="predict_residual">
                                        <option v-bind:value="true">True</option>
                                        <option v-bind:value="false">False</option>
                                    </select>
                                </div>
                                <div class="param-row"><label>weight_decay</label><input type="number" step="0.001" v-model.number="weight_decay"></div>
                                <div class="param-row"><label>gradient_clip_norm</label><input type="number" step="0.1" v-model.number="gradient_clip_norm"></div>
                            </div>

                            <!-- In-flow forecast models -->
                            <div class="param-section">
                                <div class="section-title">Forecast Model Configuration</div>
                                <div class="param-row">
                                    <label>Model</label>
                                    <select v-model="selected_model_config">
                                        <option value="m1">M1 Transformer</option>
                                        <option value="m2">M2 LSTM</option>
                                    </select>
                                </div>

                                <div v-if="selected_model_config === 'm1'">
                                <div class="param-row"><label>m1.model_type</label><input v-model="m1_model_type"></div>
                                <div class="param-row"><label>m1.batch_size</label><input type="number" v-model.number="m1_batch_size"></div>
                                <div class="param-row"><label>m1.downsample_seconds</label><input type="number" v-model.number="m1_downsample_seconds"><span>Seconds</span></div>
                                <div class="param-row"><label>m1.forecasting_len</label><input type="number" v-model.number="m1_forecasting_len"></div>
                                <div class="param-row"><label>m1.forecasting_len_steps</label><input type="number" v-model.number="m1_forecasting_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>m1.hidden_size</label><input type="number" v-model.number="m1_hidden_size"></div>
                                <div class="param-row"><label>m1.lr</label><input type="number" step="0.0001" v-model.number="m1_lr"><span>LR</span></div>
                                <div class="param-row"><label>m1.max_epochs</label><input type="number" v-model.number="m1_max_epochs"><span>Epochs</span></div>
                                <div class="param-row"><label>m1.num_heads</label><input type="number" v-model.number="m1_num_heads"></div>
                                <div class="param-row"><label>m1.num_layers</label><input type="number" v-model.number="m1_num_layers"></div>
                                <div class="param-row"><label>m1.patch_len</label><input type="number" v-model.number="m1_patch_len"></div>
                                <div class="param-row"><label>m1.patch_len_steps</label><input type="number" v-model.number="m1_patch_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>m1.patience</label><input type="number" v-model.number="m1_patience"><span>Epochs</span></div>
                                <div class="param-row"><label>m1.scheduler_patience</label><input type="number" v-model.number="m1_scheduler_patience"><span>Epochs</span></div>
                                <div class="param-row"><label>m1.seq_len</label><input type="number" v-model.number="m1_seq_len"></div>
                                <div class="param-row"><label>m1.seq_len_steps</label><input type="number" v-model.number="m1_seq_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>m1.stride_seconds</label><input type="number" v-model.number="m1_stride_seconds"><span>Seconds</span></div>
                                <div class="param-row"><label>m1.stride_steps</label><input type="number" v-model.number="m1_stride_steps"><span>Steps</span></div>
                                <div class="param-row"><label>m1.weight_decay</label><input type="number" step="0.001" v-model.number="m1_weight_decay"></div>
                                </div>

                                <div v-else>
                                <div class="param-row"><label>m2.model_type</label><input v-model="m2_model_type"></div>
                                <div class="param-row"><label>m2.batch_size</label><input type="number" v-model.number="m2_batch_size"></div>
                                <div class="param-row"><label>m2.downsample_seconds</label><input type="number" v-model.number="m2_downsample_seconds"><span>Seconds</span></div>
                                <div class="param-row"><label>m2.forecasting_len</label><input type="number" v-model.number="m2_forecasting_len"></div>
                                <div class="param-row"><label>m2.forecasting_len_steps</label><input type="number" v-model.number="m2_forecasting_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>m2.hidden_size</label><input type="number" v-model.number="m2_hidden_size"></div>
                                <div class="param-row"><label>m2.lr</label><input type="number" step="0.0001" v-model.number="m2_lr"><span>LR</span></div>
                                <div class="param-row"><label>m2.max_epochs</label><input type="number" v-model.number="m2_max_epochs"><span>Epochs</span></div>
                                <div class="param-row"><label>m2.num_heads</label><input type="number" v-model.number="m2_num_heads"></div>
                                <div class="param-row"><label>m2.num_layers</label><input type="number" v-model.number="m2_num_layers"></div>
                                <div class="param-row"><label>m2.patch_len</label><input type="number" v-model.number="m2_patch_len"></div>
                                <div class="param-row"><label>m2.patch_len_steps</label><input type="number" v-model.number="m2_patch_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>m2.patience</label><input type="number" v-model.number="m2_patience"><span>Epochs</span></div>
                                <div class="param-row"><label>m2.scheduler_patience</label><input type="number" v-model.number="m2_scheduler_patience"><span>Epochs</span></div>
                                <div class="param-row"><label>m2.seq_len</label><input type="number" v-model.number="m2_seq_len"></div>
                                <div class="param-row"><label>m2.seq_len_steps</label><input type="number" v-model.number="m2_seq_len_steps"><span>Steps</span></div>
                                <div class="param-row"><label>m2.stride_seconds</label><input type="number" v-model.number="m2_stride_seconds"><span>Seconds</span></div>
                                <div class="param-row"><label>m2.stride_steps</label><input type="number" v-model.number="m2_stride_steps"><span>Steps</span></div>
                                <div class="param-row"><label>m2.weight_decay</label><input type="number" step="0.001" v-model.number="m2_weight_decay"></div>
                                </div>
                            </div>

                            <!-- Search -->
                            <div class="param-section">
                                <div class="section-title">Search</div>

                                <div class="param-row"><label>n_trials</label><input v-model="n_trials"><span>Trials</span></div>
                                <div class="param-row"><label>num_epoches_search</label><input v-model="num_epoches_search"><span>Epochs</span></div>

                                <!-- param_grid.hidden_size -->
                                <div class="param-row">
                                    <label>param_grid.hidden_size</label>
                                    <div class="param-array">
                                        <div v-for="(v,i) in param_grid_hidden_size" :key="i" class="array-item">
                                            <input v-model.number="param_grid_hidden_size[i]">
                                            <button v-on:click="param_grid_hidden_size.splice(i,1)">x</button>
                                        </div>
                                        <button v-on:click="param_grid_hidden_size.push(0)">+</button>
                                    </div>
                                </div>

                                <!-- param_grid.num_layers -->
                                <div class="param-row">
                                    <label>param_grid.num_layers</label>
                                    <div class="param-array">
                                        <div v-for="(v,i) in param_grid_num_layers" :key="i" class="array-item">
                                            <input v-model.number="param_grid_num_layers[i]">
                                            <button v-on:click="param_grid_num_layers.splice(i,1)">x</button>
                                        </div>
                                        <button v-on:click="param_grid_num_layers.push(1)">+</button>
                                    </div>
                                </div>

                                <!-- param_grid.lr -->
                                <div class="param-row">
                                    <label>param_grid.lr</label>
                                    <div class="param-array">
                                        <div v-for="(v,i) in param_grid_lr" :key="i" class="array-item">
                                            <input v-model.number="param_grid_lr[i]">
                                            <button v-on:click="param_grid_lr.splice(i,1)">x</button>
                                        </div>
                                        <button v-on:click="param_grid_lr.push(0.001)">+</button>
                                    </div>
                                    <span>LR</span>
                                </div>

                                <!-- param_grid.batch_size -->
                                <div class="param-row">
                                    <label>param_grid.batch_size</label>
                                    <div class="param-array">
                                        <div v-for="(v,i) in param_grid_batch_size" :key="i" class="array-item">
                                            <input v-model.number="param_grid_batch_size[i]">
                                            <button v-on:click="param_grid_batch_size.splice(i,1)">x</button>
                                        </div>
                                        <button v-on:click="param_grid_batch_size.push(256)">+</button>
                                    </div>
                                </div>

                                <!-- gsi_param_grid -->
                                <div class="param-row">
                                    <label>gsi_param_grid.hidden_size</label>
                                    <div class="param-array">
                                        <div v-for="(v,i) in gsi_param_grid_hidden_size" :key="i" class="array-item">
                                            <input v-model.number="gsi_param_grid_hidden_size[i]">
                                            <button v-on:click="gsi_param_grid_hidden_size.splice(i,1)">x</button>
                                        </div>
                                        <button v-on:click="gsi_param_grid_hidden_size.push(64)">+</button>
                                    </div>
                                </div>

                                <div class="param-row">
                                    <label>gsi_param_grid.latend_dim</label>
                                    <div class="param-array">
                                        <div v-for="(v,i) in gsi_param_grid_latend_dim" :key="i" class="array-item">
                                            <input v-model.number="gsi_param_grid_latend_dim[i]">
                                            <button v-on:click="gsi_param_grid_latend_dim.splice(i,1)">x</button>
                                        </div>
                                        <button v-on:click="gsi_param_grid_latend_dim.push(3)">+</button>
                                    </div>
                                </div>

                                <div class="param-row">
                                    <label>gsi_param_grid.dropout</label>
