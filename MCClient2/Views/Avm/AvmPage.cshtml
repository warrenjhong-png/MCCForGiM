                        </button>
                        <button type="button"
                                class="k-button k-primary"
                                v-bind:disabled="rawDataStopSubmitting"
                                v-on:click="requestStopRawDataDownload">
                            {{ rawDataStopSubmitting
                            ? "送出停止要求中..."
                            : "目前封包完成後停止" }}
                        </button>
                    </div>
                    <div class="rawdata-download-stop-error"
                         v-if="rawDataStopError">
                        {{ rawDataStopError }}
                    </div>
                </div>

                <div class="rawdata-download-stop-requested"
                     v-if="rawDataStopRequested && rawDataDownloadStatus !== 'Stopped'">
                    已送出停止要求。系統會完成目前封包，之後不再下載下一個封包。
                </div>

                <div class="rawdata-download-stopped"
                     v-if="rawDataDownloadStatus === 'Stopped'">
                    下載已停止（部分完成）。已完成：
                    {{ rawDataCompletedBatches }} /
                    {{ rawDataTotalBatches }}；未下載：
                    {{ rawDataRemainingBatches }}。已完成的資料已保留。
                    <div class="rawdata-download-actions">
                        <button type="button"
                                class="k-button k-primary"
                                v-on:click="closeModelProgress">
                            關閉視窗
                        </button>
                    </div>
                </div>

            </div>

            <!-- 建模中 -->
            <div v-if="modelProcessStage === 'Model'"
                 class="model-building-area">

                <span class="model-building-spinner"></span>

                <span>
                    {{ modelProcessMessage }}
                </span>
            </div>

            <!-- 建模完成，輸入 Model Name -->
            <div v-if="modelProcessStage === 'Completed'"
                 class="model-name-area">

                <label class="model-name-label">
                    Model Name
                </label>

                <input type="text"
                       class="k-textbox model-name-input"
                       v-model.trim="modelName"
                       placeholder="請輸入 Model Name"
                       v-on:keyup.enter="uploadCompletedModel">

                <div class="model-name-error"
                     v-if="modelNameError">

                    {{ modelNameError }}
                </div>

                <div class="model-name-buttons">

                    <button type="button"
                            class="k-button k-primary"
                            v-bind:disabled="modelUploading"
                            v-on:click="uploadCompletedModel">

                        {{ modelUploading
                        ? "Uploading..."
                        : "Upload Model" }}
                    </button>

                    <button type="button"
                            class="k-button"
                            v-bind:disabled="modelUploading"
                            v-on:click="closeModelProgress">

                        Close
                    </button>

                </div>
            </div>

            <!-- 上傳中 -->
            <div v-if="modelProcessStage === 'Uploading'"
                 class="model-building-area">

                <span class="model-building-spinner"></span>

                <span>
                    正在上傳模型...
                </span>
            </div>

            <!-- 完成 -->
            <div v-if="modelProcessStage === 'Uploaded'"
                 class="model-progress-completed">

                {{ modelUploadResult }}

                <div class="model-name-buttons">
                    <button type="button"
                            class="k-button k-primary"
                            v-on:click="closeModelProgress">
                        關閉視窗
                    </button>
                </div>
            </div>

            <!-- 失敗 -->
            <div v-if="modelProcessStage === 'Failed'"
                 class="model-progress-failed">

                <div class="model-error-summary">
                    {{ modelProcessMessage }}
                </div>

                <details class="model-error-details"
                         v-if="modelProcessError">
                    <summary>顯示技術細節</summary>
                    <pre>{{ modelProcessError }}</pre>
                </details>

                <div class="model-name-buttons">
                    <button type="button"
                            class="k-button k-primary"
                            v-on:click="closeModelProgress">
                        關閉視窗
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>
